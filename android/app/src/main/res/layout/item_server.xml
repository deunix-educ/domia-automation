<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#161b22"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Connection dot: green when connected -->
    <View
        android:id="@+id/server_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/ic_status_offline"
        android:layout_marginEnd="12dp"/>

    <!-- Name and URL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e6edf3"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_server_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8b949e"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:ellipsize="end"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Edit -->
    <ImageButton
        android:id="@+id/btn_edit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#8b949e"
        android:contentDescription="@string/edit"/>

    <!-- Delete -->
    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#f85149"
        android:contentDescription="@string/delete"/>

</LinearLayout>
