   "trigger_config": {
    "key": "action",
    "value": "single_left",
    "friendly_name": "Volet-SB-est"
   },
   "action_type": "script",
   "action_config": {}
  },
  {
   "name": "Volet-SB-est → droite (close/stop)",
   "trigger_type": "device_state",
   "trigger_config": {
    "key": "action",
    "value": "single_right",
    "friendly_name": "Volet-SB-est"
   },
   "action_type": "script",
   "action_config": {}
  },
  {
   "name": "Volets — coucher du soleil",
   "trigger_type": "solar",
   "trigger_config": {
    "event": "sunset",
    "latitude": 43.3,
    "longitude": 5.4
   },
   "action_type": "scene",
   "action_config": {
    "scene_id": 1
   }
  },
  {
   "name": "Volets — lever du soleil",
   "trigger_type": "solar",
