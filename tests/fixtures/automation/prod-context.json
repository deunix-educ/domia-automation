 "automations": [
  {
   "name": "TC Salon → Volet Fermer",
   "trigger_type": "device_state",
   "trigger_config": {
    "key": "action",
    "value": "3_single",
    "friendly_name": "Tele-commande"
   },
   "action_type": "mqtt_publish",
   "action_config": {
    "topic": "zigbee2mqtt/Volet-salon/set",
    "payload": {
     "state": "CLOSE"
    }
   }
  },
  {
   "name": "TC Salon → Volet Ouvrir",
   "trigger_type": "device_state",
   "trigger_config": {
    "key": "action",
    "value": "1_single",
    "friendly_name": "Tele-commande"
   },
   "action_type": "mqtt_publish",
   "action_config": {
    "topic": "zigbee2mqtt/Volet-salon/set",
    "payload": {
     "state": "OPEN"
    }
   }
  },
  {
   "name": "TC Salon → Volet Stopper",
   "trigger_type": "device_state",
   "trigger_config": {
    "key": "action",
    "value": "2_single",
    "friendly_name": "Tele-commande"
   },
   "action_type": "mqtt_publish",
   "action_config": {
    "topic": "zigbee2mqtt/Volet-salon/set",
    "payload": {
     "state": "STOP"
    }
   }
  },
  {
   "name": "Volet-SB-est ← gauche (open/stop)",
