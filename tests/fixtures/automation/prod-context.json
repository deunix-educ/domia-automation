 "alert_rules": [
  {
   "name": "Heat wave — temperature > 35°C",
   "device": "meteo_locale",
   "key": "temperature",
   "operator": "gt",
   "threshold_num": 35.0,
   "threshold_str": null,
   "severity": "warning",
   "cooldown_minutes": 60,
   "notify": {
    "email": true,
    "sms": false,
    "android": true
   }
  }
 ]
