  "query": "SELECT id, friendly_name, ieee, vendor, model_id, description, device_type, group_id, location_id, base_topic, state, last_seen, available, exposes, active, icon, image_url, tracked_keys, hidden_keys, grafana_dashboard, false AS \"created!\" FROM device\n             WHERE ($1::bigint IS NULL OR group_id = $1) AND ($2::bigint IS NULL OR location_id = $2)\n               AND ($3::text IS NULL OR device_type = $3) AND (NOT $4 OR active)\n             ORDER BY friendly_name, id",
