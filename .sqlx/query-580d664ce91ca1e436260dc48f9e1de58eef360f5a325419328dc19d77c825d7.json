{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id AS m_id, m.sender_id, m.subject, m.body, m.channel, m.status, m.created_at, m.sent_at, m.recipients_count,\n                    r.id AS r_id, r.recipient_id, r.email_status, r.sms_status, r.error, r.updated_at\n             FROM message_recipient r JOIN message m ON m.id = r.message_id\n             WHERE r.recipient_id = $1 ORDER BY m.created_at DESC, m.id DESC LIMIT $2",
