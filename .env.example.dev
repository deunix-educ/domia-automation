# DomiNet: DEV variables. The dev infrastructure stack (`make dev-up`) sets its own throw-away secrets; this file is used for
# `make dev-run` (DomiNet launched from the sources) if you want to override something. Copy to `.env` (never committed).
DATABASE_URL=postgres://dominet:dominet-dev@127.0.0.1:15432/dominet
MQTT_HOST=127.0.0.1
MQTT_PORT=11883
REDUCTSTORE_URL=http://127.0.0.1:18383
REDUCTSTORE_TOKEN=dominet-dev-token
MEDIAMTX_API_URL=http://127.0.0.1:19997
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:18554
COOKIE_SECURE=false
LOG_FORMAT=pretty
#DOMINET_MASTER_KEY=   # dominet gen-master-key
