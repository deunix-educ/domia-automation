# DomiNet : variables de DEV. La stack d'infrastructure de dev (`make dev-up`) fixe elle-meme ses secrets jetables ; ce fichier sert a
# `make dev-run` (DomiNet lance depuis les sources) si l'on veut surcharger quelque chose. Copier en `.env` (jamais commite).
DATABASE_URL=postgres://dominet:dominet-dev@127.0.0.1:15432/dominet
MQTT_HOST=127.0.0.1
MQTT_PORT=11883
REDUCTSTORE_URL=http://127.0.0.1:18383
REDUCTSTORE_TOKEN=dominet-dev-token
MEDIAMTX_API_URL=http://127.0.0.1:19997
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:18554
COOKIE_SECURE=false
LOG_FORMAT=pretty
#DOMINET_MASTER_KEY=   # dominet gen-master-key
