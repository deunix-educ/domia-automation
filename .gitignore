/target
/target-rel
/dist
/site
.env
.env.*
!.env.example*
*.log
.DS_Store

# Python (E2E scripts and tools)
__pycache__/
*.pyc

# Segments recorded by the dev MediaMTX
/deploy/recordings-dev/

# YOLO model (make fetch-model)
/models/*.onnx
/models/*.pt

# Deployment files specific to an installation
/certs/
/deploy/zigbee2mqtt/*
!/deploy/zigbee2mqtt/configuration.example.yaml

# Local appearance customisation (copy of deploy/custom/custom.css.example)
/deploy/custom/custom.css

# Local data (detection images, etc.): never versioned
/data/

# The agent's private notes (never committed)
/CLAUDE.local.md

# Android application (android/): build output and signing material
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
/android/*.jks
/android/*.keystore
/android/keystore.properties
