{
  "title": "DomiNet — Météo",
  "uid": "dominet-weather",
  "schemaVersion": 38,
  "version": 7,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Station",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgresql"
        },
        "query": "SELECT id::text AS \"__value\", friendly_name AS \"__text\" FROM device WHERE state ? 'weather_code' AND active = true ORDER BY friendly_name",
        "definition": "SELECT id::text AS \"__value\", friendly_name AS \"__text\" FROM device WHERE state ? 'weather_code' AND active = true ORDER BY friendly_name",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "meteo_locale",
          "value": "37"
        },
        "options": [
          {
            "selected": true,
            "text": "meteo_locale",
            "value": "37"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Température",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ressenti"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    4,
                    4
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT ts AS \"time\", value_num AS \"Température\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND key = 'temperature'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT ts AS \"time\", value_num AS \"Ressenti\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND key = 'feels_like'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Humidité & Couverture nuageuse",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT ts AS \"time\", value_num AS \"Humidité\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND key = 'humidity'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT ts AS \"time\", value_num AS \"Nuages\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND key = 'cloud_cover'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Vent",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT ts AS \"time\", value_num AS \"Vitesse vent\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND key = 'wind_speed'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Précipitations",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmm",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "bars"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT ts AS \"time\", value_num AS \"Précipitations\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND key = 'precipitation'\n  AND $__timeFilter(ts)\nORDER BY ts",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Valeurs actuelles",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Température"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurehpa"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "UV"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pluie"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthmm"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "rawSql": "SELECT\n  MAX(CASE WHEN key='temperature'   THEN value_num END) AS \"Température\",\n  MAX(CASE WHEN key='humidity'      THEN value_num END) AS \"Humidité\",\n  MAX(CASE WHEN key='wind_speed'    THEN value_num END) AS \"Vent\",\n  MAX(CASE WHEN key='pressure'      THEN value_num END) AS \"Pression\",\n  MAX(CASE WHEN key='uv_index'      THEN value_num END) AS \"UV\",\n  MAX(CASE WHEN key='precipitation' THEN value_num END) AS \"Pluie\"\nFROM device_state_log\nWHERE device_id = ${station}\n  AND ts >= NOW() - INTERVAL '1 hour'",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
