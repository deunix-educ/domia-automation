    --bg-base       : #0b0f14;      fond de page
    --bg-surface    : #161b22;      fond du menu et des cartes
    --text-primary  : #f5f7fa;      texte principal
    --radius-md     : 4px;          arrondis des cartes
    --sidebar-w     : 260px;        largeur du menu de gauche
    --font          : "DejaVu Sans", system-ui, sans-serif;
} */
