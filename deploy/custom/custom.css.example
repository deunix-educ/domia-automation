/*
 * Customisation of DomiNet's appearance: copy this file to `custom.css` (in this folder), uncomment and edit.
 * It is loaded after the main stylesheet and re-read on each page load: no restart, no rebuild.
 * To go back to the original appearance: delete `custom.css`. The available variables are described in docs/appearance.md.
 */

/* :root {
    --accent        : #ff9f1a;      main colour (buttons, active links)
    --accent-dim    : #d98200;      darker variant
    --bg-base       : #0b0f14;      page background
    --bg-surface    : #161b22;      background of the menu and the cards
    --text-primary  : #f5f7fa;      main text
    --radius-md     : 4px;          card corner radius
    --sidebar-w     : 260px;        width of the left menu
    --font          : "DejaVu Sans", system-ui, sans-serif;
} */
