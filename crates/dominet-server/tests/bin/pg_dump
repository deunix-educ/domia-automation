#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Test PostgreSQL client: the `pg_dump` of the container that publishes the database port (the dev stack, or the pre-push hook's throw-away database);
# the machine has no client installed. The backup service passes the connection through the environment (PGHOST, PGPORT, PGUSER,
# PGPASSWORD, PGDATABASE, from the host's point of view); we find the container by its published port and talk to its local PostgreSQL.
set -euo pipefail
cid="$(docker ps -q --filter "publish=${PGPORT:?}" | head -1)"
[ -n "$cid" ] || { echo "pg_dump : aucun conteneur ne publie le port $PGPORT" >&2; exit 2; }
exec docker exec -i -e PGUSER -e PGPASSWORD -e PGDATABASE -e PGHOST=127.0.0.1 -e PGPORT=5432 "$cid" pg_dump "$@"
