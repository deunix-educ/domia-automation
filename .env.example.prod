# SPDX-License-Identifier: AGPL-3.0-or-later
# DomiNet: PRODUCTION environment variables. `make prod-init` copies this file to `.env` (never committed), generates the secrets
# and fills in the network; all that remains is to review the lines marked TODO.
# Complete reference of the variables read by the application: docs/configuration.md.

# --- Network -------------------------------------------------------------------------------------------------------
# Main LAN name or IP (must appear in the certificate: `make certs`).
LAN_DOMAIN=TODO.local
# Second name or IP if the server has another one (optional), then additional names of the certificate (comma-separated).
LOCAL_DOMAIN=
#CERT_EXTRA_SANS=
ALLOWED_HOSTS=TODO.local
CSRF_TRUSTED_ORIGINS=https://TODO.local
# Networks whose X-Forwarded-For is trusted: the Docker network (nginx).
TRUSTED_PROXIES=172.16.0.0/12
COOKIE_SECURE=true
# Ports published by nginx (80/443 by default).
#NGINX_HTTP_PORT=80
#NGINX_HTTPS_PORT=443
TZ=Europe/Paris

# --- Database (secrets generated by `make prod-init`) ---------------------------------------------------------------
DB_NAME=dominet
DB_USER=dominet
DB_PASSWORD=
#POSTGRES_HOST_PORT=5432

# --- Application ----------------------------------------------------------------------------------------------------
# AES-256 key for encrypting secrets at rest (`dominet gen-master-key`): TO BE BACKED UP OFF THE MACHINE, without it the camera passwords
# and the keys encrypted in the database are lost.
DOMINET_MASTER_KEY=
DOMINET_TAG=local
# Application image: `make prod-up` first tries the published image (GHCR, amd64 and arm64) then builds locally (ADR 0062).
# DOMINET_PULL=0 forces the build; DOMINET_IMAGE_VERSION=latest (or a version tag); DOMINET_REGISTRY_IMAGE=ghcr.io/deunix-educ/domia-automation
#DOMINET_PULL=
#DOMINET_IMAGE_VERSION=
#DOMINET_REGISTRY_IMAGE=

# --- Video ----------------------------------------------------------------------------------------------------------
# Service account of DomiNet's `video` role: MediaMTX asks DomiNet to authorise every read (ADR 0064), its own included.
# Generated by `make prod-init` (or at the next `make prod-up` on an older installation); never shown or shared.
MEDIAMTX_READ_USER=
MEDIAMTX_READ_PASSWORD=

# --- MQTT -----------------------------------------------------------------------------------------------------------
# A single listener, with a password for everyone (never anonymous, ADR 0057). Internal account below: DomiNet and Zigbee2MQTT.
# LAN clients (Linky, SolarMax...): one account each, `make prod-mqtt-user NAME=linky` (subject limited to linky/#).
MQTT_USER=dominet
MQTT_PASSWORD=
# Host port for the LAN (default 1883)
#MQTT_LAN_PORT=1883

# --- Zigbee2MQTT (zigbee profile, USB dongle) -----------------------------------------------------------------------
ZIGBEE_DEVICE=/dev/ttyUSB0
ZIGBEE_AUTH_TOKEN=

# --- Video ----------------------------------------------------------------------------------------------------------
# Hardware decoding (VAAPI): written by `make prod-init` / `make prod-video` if /dev/dri/renderD128 exists (gid of the host's render group).
#VIDEO_DEVICE=/dev/dri
#RENDER_GID=
# Hosts announced to the browser for the WebRTC stream (UDP 8189), comma-separated: LAN name + LAN IP (+ IP of another VPN).
WEBRTC_ADDITIONAL_HOSTS=
# WebRTC address and scheme read by `dominet seed` (settings editable afterwards in the interface).
MEDIAMTX_WEBRTC_DOMAIN=TODO.local/webrtc
MEDIAMTX_WEBRTC_SCHEME=https
REDUCTSTORE_TOKEN=
VIDEO_QUOTA_GB=50
IOT_QUOTA_GB=5
#FFMPEG_HWACCEL=auto
#YOLO_WORKERS=1

# --- Grafana --------------------------------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_PUBLIC_URL=https://TODO.local
PROMETHEUS_PUBLIC_URL=

# --- Backups (backups-data volume, 03:00 every day) -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR=3

# --- E-mail and SMS (alerts; see docs/notifications.md) -------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_RECIPIENT=
DEFAULT_FROM_EMAIL=
#SMS_FREE_USER=
#SMS_FREE_KEY=

# --- Data providers (optional) --------------------------------------------------------------------------------------
#SOLARMAX_HOST=
#SOLARMAX_INVERTER_ID=1

# --- WireGuard VPN (vpn profile, access from outside) ---------------------------------------------------------------
DYNDNS_HOST=
WG_ADMIN_HASH=
WG_DEFAULT_ADDRESS=10.20.0.x
WG_SUBNET=10.20.0.0/24
WG_ALLOWED_IPS=10.20.0.0/24
