# SPDX-License-Identifier: AGPL-3.0-or-later
# DomiNet : variables d'environnement de PRODUCTION. `make prod-init` copie ce fichier en `.env` (jamais commite), genere les secrets
# et renseigne le reseau ; il ne reste qu'a relire les lignes marquees TODO.
# Reference complete des variables lues par l'application : docs/configuration.md.

# --- Reseau --------------------------------------------------------------------------------------------------------
# Nom ou IP LAN principal (doit figurer dans le certificat : `make certs`).
LAN_DOMAIN=TODO.local
# Deuxieme nom ou IP si le serveur en a un autre (optionnel), puis noms supplementaires du certificat (separes par des virgules).
LOCAL_DOMAIN=
#CERT_EXTRA_SANS=
ALLOWED_HOSTS=TODO.local
CSRF_TRUSTED_ORIGINS=https://TODO.local
# Reseaux dont on croit X-Forwarded-For : le reseau Docker (nginx).
TRUSTED_PROXIES=172.16.0.0/12
COOKIE_SECURE=true
# Ports publies par nginx (80/443 par defaut).
#NGINX_HTTP_PORT=80
#NGINX_HTTPS_PORT=443
TZ=Europe/Paris

# --- Base de donnees (secrets generes par `make prod-init`) ---------------------------------------------------------
DB_NAME=dominet
DB_USER=dominet
DB_PASSWORD=
#POSTGRES_HOST_PORT=5432

# --- Application ----------------------------------------------------------------------------------------------------
# Cle AES-256 du chiffrement des secrets au repos (`dominet gen-master-key`) : A SAUVEGARDER HORS DE LA MACHINE, sans elle les mots de
# passe de cameras et les cles chiffrees en base sont perdus.
DOMINET_MASTER_KEY=
DOMINET_TAG=local
# Image de l'application : `make prod-up` essaie d'abord l'image publiee (GHCR, amd64 et arm64) puis construit en local (ADR 0062).
# DOMINET_PULL=0 force la construction ; DOMINET_IMAGE_VERSION=latest (ou une etiquette de version) ; DOMINET_REGISTRY_IMAGE=ghcr.io/deunix-educ/domia-automation
#DOMINET_PULL=
#DOMINET_IMAGE_VERSION=
#DOMINET_REGISTRY_IMAGE=

# --- MQTT -----------------------------------------------------------------------------------------------------------
# Un seul listener, avec mot de passe pour tous (jamais anonyme, ADR 0057). Compte interne ci-dessous : DomiNet et Zigbee2MQTT.
# Clients du LAN (Linky, SolarMax...) : un compte chacun, `make prod-mqtt-user NAME=linky` (sujet limite a linky/#).
MQTT_USER=dominet
MQTT_PASSWORD=
# Port de l'hote pour le LAN (defaut 1883)
#MQTT_LAN_PORT=1883

# --- Zigbee2MQTT (profil zigbee, dongle USB) ------------------------------------------------------------------------
ZIGBEE_DEVICE=/dev/ttyUSB0
ZIGBEE_AUTH_TOKEN=

# --- Video ----------------------------------------------------------------------------------------------------------
# Decodage materiel (VAAPI) : ecrit par `make prod-init` / `make prod-video` si /dev/dri/renderD128 existe (gid du groupe render de l'hote).
#VIDEO_DEVICE=/dev/dri
#RENDER_GID=
# Hotes annonces au navigateur pour le flux WebRTC (UDP 8189), separes par des virgules : nom LAN + IP du LAN (+ IP d'un autre VPN).
WEBRTC_ADDITIONAL_HOSTS=
# Adresse WebRTC et schema lus par `dominet seed` (reglages modifiables ensuite dans l'interface).
MEDIAMTX_WEBRTC_DOMAIN=TODO.local/webrtc
MEDIAMTX_WEBRTC_SCHEME=https
REDUCTSTORE_TOKEN=
VIDEO_QUOTA_GB=50
IOT_QUOTA_GB=5
#FFMPEG_HWACCEL=auto
#YOLO_WORKERS=1

# --- Grafana --------------------------------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_PUBLIC_URL=https://TODO.local
PROMETHEUS_PUBLIC_URL=

# --- Sauvegardes (volume backups-data, 03:00 chaque jour) -----------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR=3

# --- Courriel et SMS (alertes ; voir docs/notifications.md) ---------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_RECIPIENT=
DEFAULT_FROM_EMAIL=
#SMS_FREE_USER=
#SMS_FREE_KEY=

# --- Fournisseurs de donnees (optionnel) ----------------------------------------------------------------------------
#SOLARMAX_HOST=
#SOLARMAX_INVERTER_ID=1

# --- VPN WireGuard (profil vpn, acces depuis l'exterieur) -----------------------------------------------------------
DYNDNS_HOST=
WG_ADMIN_HASH=
WG_DEFAULT_ADDRESS=10.20.0.x
WG_SUBNET=10.20.0.0/24
WG_ALLOWED_IPS=10.20.0.0/24
